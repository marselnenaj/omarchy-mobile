# SPDX-License-Identifier: MIT
# Restore touch fly-off, flick and spring-back in the 4.5 scene toast.
# Reported by jkjoplin while testing #471 on cheetah.
# Preserve the keyed scene opacity and existing dismissal signal contract.

diff --git a/shell/plugins/notifications/Toast.qml b/shell/plugins/notifications/Toast.qml
--- a/shell/plugins/notifications/Toast.qml
+++ b/shell/plugins/notifications/Toast.qml
@@ -28,6 +28,93 @@
   property real cardWidth: Style.space(380)
   property string replyPlaceholder: ""
   property bool replyOpen: false
+  property real swipeOffset: 0
+  property real swipeVelocity: 0
+  property bool dismissing: false
+  transform: Translate { x: card.swipeOffset }
+
+  // Keep the proven touch interaction from the legacy card: follow the
+  // finger directly, then fly off or spring back after release.
+  function cancelSwipe() {
+    swipeAnimation.stop()
+    swipeResetTimer.stop()
+    card.dismissing = false
+    card.swipeOffset = 0
+    card.swipeVelocity = 0
+  }
+
+  function finishSwipe() {
+    if (card.replyOpen || card.place.hidden || card.place.leaving) {
+      card.cancelSwipe()
+      return
+    }
+    var distance = Math.abs(card.swipeOffset)
+    var sameWay = card.swipeVelocity * card.swipeOffset > 0
+    var flung = sameWay && Math.abs(card.swipeVelocity) >= Style.space(900)
+        && distance >= card.width * 0.1
+    swipeAnimation.dismiss = card.width > 0 && (distance >= card.width * 0.35 || flung)
+    if (swipeAnimation.dismiss) {
+      card.dismissing = true
+      swipeAnimation.to = (card.swipeOffset < 0 ? -1 : 1) * (card.width + Style.space(24))
+    } else {
+      swipeAnimation.to = 0
+    }
+    swipeAnimation.restart()
+  }
+
+  DragHandler {
+    id: swipeHandler
+    target: null
+    enabled: !card.replyOpen && !card.place.hidden && !card.place.leaving && !card.dismissing
+    acceptedDevices: PointerDevice.TouchScreen
+    dragThreshold: Style.space(12)
+    onCanceled: card.cancelSwipe()
+    xAxis.enabled: true
+    yAxis.enabled: false
+    onActiveChanged: {
+      if (active) {
+        swipeAnimation.stop()
+        card.swipeVelocity = 0
+      } else {
+        card.finishSwipe()
+      }
+    }
+    onActiveTranslationChanged: {
+      if (!active) return
+      card.swipeOffset = activeTranslation.x
+      card.swipeVelocity = centroid.velocity.x
+    }
+  }
+
+  SequentialAnimation {
+    id: swipeAnimation
+    property real to: 0
+    property bool dismiss: false
+    NumberAnimation {
+      target: card
+      property: "swipeOffset"
+      to: swipeAnimation.to
+      duration: swipeAnimation.dismiss ? 140 : 200
+      easing.type: swipeAnimation.dismiss ? Easing.InQuad : Easing.OutBack
+    }
+    ScriptAction {
+      script: {
+        if (!swipeAnimation.dismiss) return
+        card.dismissed()
+        // A container retaining the toast gets a usable card back.
+        swipeResetTimer.restart()
+      }
+    }
+  }
+
+  Timer {
+    id: swipeResetTimer
+    interval: 400
+    onTriggered: {
+      card.dismissing = false
+      card.swipeOffset = 0
+    }
+  }
   signal replyRequested()
   signal replyCancelled()
   signal replySent(string text)
@@ -216,6 +303,7 @@
   z: place.z
   scale: scene ? scene.at(row.key, "scale") : 1
   opacity: place.hidden ? 0 : (scene ? scene.at(row.key, "opacity") : 1)
+      * (1 - 0.6 * Math.min(1, Math.abs(card.swipeOffset) / Math.max(1, card.width)))
   transformOrigin: Item.Top

   // `visible` is deliberately unbound: anything derived from layout output
@@ -454,7 +542,7 @@
                 anchors.centerIn: parent
                 text: card.ago()
                 color: card.dimColor
-                opacity: card.hovered ? 0 : 1
+                opacity: 0
                 visible: opacity > 0.01
                 font.family: Style.font.family
                 font.pixelSize: Style.font.bodySmall
@@ -465,10 +553,10 @@
                 id: shut
                 anchors.right: parent.right
                 anchors.verticalCenter: parent.verticalCenter
-                implicitWidth: closeMark.implicitWidth + Style.space(6)
-                implicitHeight: closeMark.implicitHeight
+                implicitWidth: Math.max(Style.space(40), closeMark.implicitWidth + Style.space(6))
+                implicitHeight: Math.max(Style.space(40), closeMark.implicitHeight)
                 enabled: card.hovered
-                opacity: card.hovered ? 1 : 0
+                opacity: 1
                 visible: opacity > 0.01
                 readonly property bool hot: card.pointerOver(shut)
                 Behavior on opacity { NumberAnimation { duration: card.fade; easing.type: Easing.InOutQuad } }
