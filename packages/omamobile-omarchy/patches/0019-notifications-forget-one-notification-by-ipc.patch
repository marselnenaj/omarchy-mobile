# Keyed deletion and live-only sender activation; never execute history actions.

--- a/shell/plugins/notifications/Service.qml
+++ b/shell/plugins/notifications/Service.qml
@@ -826,7 +826,7 @@
     delete heights[key]
     delete fresh[key]
     // A placeholder (the empty-history notice) was never recorded.
-    if (key.indexOf("placeholder") !== 0) storeClose(key, reason)
+    if (key.indexOf("placeholder") !== 0 && reason !== "forget") storeClose(key, reason)
     layoutRevision += 1
   }
 
@@ -1220,6 +1220,35 @@
   }
 
   // A row that closes moves from live to history.
+  // Key-based4.5 store deletion. Never construct an arbitrary path or run
+  // notification actions; forget removes only the named logical record.
+  function forgetNotification(name) {
+    var key = String(name || "")
+    if (!Store.KEY.test(key)) return "none"
+    if (!liveLoaded || !historyLoaded) return "busy"
+    var exists = !!liveKeys[key] || !!Store.liveEntry(liveEntries, key)
+        || historyEntries.some(function(entry) { return entry.key === key })
+    if (!exists) return "ok"
+    storeDrop(key)
+    historyEntries = historyEntries.filter(function(entry) { return entry.key !== key })
+    saveSoon("history")
+    closeToast(key, "forget", true)
+    return "ok"
+  }
+
+  // Snapshot logical keys before removal. New notifications arriving after
+  // this call have new keys and are never covered by the center's tombstones.
+  function forgetAllNotifications() {
+    if (!liveLoaded || !historyLoaded) return JSON.stringify({ result: "busy", keys: [] })
+    var keys = Object.keys(liveKeys)
+    liveEntries.concat(historyEntries).forEach(function(entry) {
+      if (keys.indexOf(entry.key) < 0) keys.push(entry.key)
+    })
+    keys = keys.filter(function(key) { return Store.KEY.test(key) })
+    for (var i = 0; i < keys.length; i++) forgetNotification(keys[i])
+    return JSON.stringify({ result: "ok", keys: keys })
+  }
+
   function storeClose(key, reason) {
     var entry = Store.liveEntry(liveEntries, key)
     if (!entry) return
@@ -1429,6 +1458,18 @@
     target: "notifications"
 
     function ping(): string { return "ok" }
+
+    function forget(name: string): string { return service.forgetNotification(name) }
+
+    function forgetAll(): string { return service.forgetAllNotifications() }
+
+    // Persisted history cannot assert a sender capability: resolve live now.
+    function activateLive(name: string): string {
+      var key = String(name || "")
+      if (!Store.KEY.test(key) || !service.refs[key] || service.rowIndexFor(key) < 0) return "none"
+      service.activate(key)
+      return "ok"
+    }
 
     function isDnd(): string { return service.doNotDisturb ? "on" : "off" }
 
