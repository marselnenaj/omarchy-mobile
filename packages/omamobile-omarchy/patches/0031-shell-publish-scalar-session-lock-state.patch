diff --git a/shell/services/AuthServiceStore.js b/shell/services/AuthServiceStore.js
--- a/shell/services/AuthServiceStore.js
+++ b/shell/services/AuthServiceStore.js
@@ -43,3 +43,20 @@
   var keys = ids()
   for (var i = 0; i < keys.length; i++) destroy(keys[i])
 }
+
+// Return scalar state only. Never export a credential-bearing service object.
+function lockSnapshot() {
+  var found = null
+  for (var key in services) {
+    var service = services[key]
+    if (service && typeof service.currentlyLocked === "function") {
+      if (found) return { known: false, locked: true }
+      found = service
+    }
+  }
+  if (!found) return { known: false, locked: true }
+  try {
+    var value = found.currentlyLocked()
+    return typeof value === "boolean" ? { known: true, locked: value } : { known: false, locked: true }
+  } catch (error) { return { known: false, locked: true } }
+}
